{
  "expo": {
    "name": "Zedd",
    "slug": "zedd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suraj1812.zedd",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#063F32"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suraj1812.zedd",
      "versionCode": 1
    },
    "web": {
      "favicon": "./public/favicon.png",
      "name": "Zedd",
      "shortName": "Zedd",
      "description": "Everyday, beautifully connected. Pay, travel, discover.",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#063F32"
        }
      ]
    ],
    "scheme": "zedd",
    "description": "Everyday, beautifully connected. Pay, travel, discover.",
    "backgroundColor": "#FAFAFC",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "28f14a8e-4d21-4a20-a2ca-5150c32aef01"
      }
    },
    "owner": "suraj01812"
  }
}
